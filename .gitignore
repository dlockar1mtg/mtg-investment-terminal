# Outputs
outputs/
reports/
exports/
snapshots/

# Logs
*.log
logs/
audit/
audits/
debug/
diagnostics/

# Large generated formats
*.parquet
*.feather
*.arrow
*.h5
*.hdf5
*.pickle
*.pkl

# Spreadsheet lock files
~$*.xlsx
~$*.xls
~$*.csv

# ------------------------------------------------------------
# Repository-controlled reference data
# ------------------------------------------------------------
!data/product_master/
!data/product_master/**
!data/reference/
!data/reference/**
!data/templates/
!data/templates/**

# Local review artifacts
data/product_master/*review*.csv
data/product_master/*candidate*.csv
data/product_master/*manual*.csv
data/product_master/*approval*.csv

# OS files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Personal portfolio holdings

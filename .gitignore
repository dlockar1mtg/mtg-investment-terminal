# ============================================================
# MTG Investment Terminal — Terminal 2.5.1a
# Production repository rules
# ============================================================

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# ------------------------------------------------------------
# Secrets and local-only configuration
# ------------------------------------------------------------
.env
.env.*
!.env.example
config_local.py
config.local.py
local_config.py
credentials.json
secrets.json
secret.json
tokens.json
auth.json
*.pem
*.key
*.p12
*.pfx
*.token

# Safe examples remain tracked
!config.example.py
!config_template.py
!credentials.example.json
!secrets.example.json

# ------------------------------------------------------------
# Local databases
# ------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
data/**/*.sqlite
data/**/*.sqlite3
data/**/*.db
workspace/**/*.sqlite
workspace/**/*.sqlite3
workspace/**/*.db

# ------------------------------------------------------------
# Downloaded and extracted archives
# ------------------------------------------------------------
*.7z
*.zip
*.rar
*.tar
*.tar.gz
*.tgz
*.bz2
*.xz

data/**/archive_cache/
data/**/archives/
data/**/downloads/
data/**/extracted/
data/**/raw_downloads/
workspace/raw/
workspace/cache/

# Preserve workspace documentation
!workspace/README.md

# ------------------------------------------------------------
# Generated data — not source controlled
# ------------------------------------------------------------
data/raw/
data/input/
data/investment/
data/market_inputs/
data/market_intelligence/
data/monte_carlo/
data/source_cache/
data/discovered/
data/market_database/
data/rolling_metrics/
data/market_signals/
data/source_runs/
data/dashboard/
data/analytics/
data/warehouse/
data/terminal2/exports/
data/terminal2/archive_cache/
data/terminal2/extracted_archives/
data/terminal2/market_audit/
data/terminal2/market_inputs/
data/terminal2/product_discovery_candidates.csv
data/terminal2/product_metadata_template.csv

workspace/analytics/
workspace/market/
workspace/monte_carlo/
workspace/history/
workspace/temp/

# ------------------------------------------------------------
# Generated exports and reports
# ------------------------------------------------------------
outputs/
reports/
exports/
snapshots/

# ------------------------------------------------------------
# Keep repository-controlled reference/configuration data
# ------------------------------------------------------------
!data/product_master/
!data/product_master/**
!data/reference/
!data/reference/**
!data/templates/
!data/templates/**

# Product master review artifacts remain local unless converted to templates
data/product_master/*review*.csv
data/product_master/*candidate*.csv
data/product_master/*manual*.csv
data/product_master/*approval*.csv

# Keep safe templates/examples
!data/product_master/*_template.csv
!data/product_master/*.example.csv
!data/product_master/README.md

# ------------------------------------------------------------
# Logs, diagnostics, and temporary artifacts
# ------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.old
*.orig
*.rej
*.pid
*.lock
logs/
audit/
audits/
debug/
diagnostics/
data/**/audit/
data/**/audits/
data/**/logs/
data/**/debug/
data/**/diagnostics/

# ------------------------------------------------------------
# Large generated formats
# ------------------------------------------------------------
*.parquet
*.feather
*.arrow
*.h5
*.hdf5
*.pickle
*.pkl

# ------------------------------------------------------------
# Spreadsheet lock files
# ------------------------------------------------------------
~$*.xlsx
~$*.xls
~$*.csv

# ------------------------------------------------------------
# Power BI local files
# ------------------------------------------------------------
*.pbix
*.pbit
*.pbip
*.bim
*.pbi
*.pbi.json
*.pbids

# ------------------------------------------------------------
# Editors and operating systems
# ------------------------------------------------------------
.vscode/
.idea/
*.code-workspace
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------
# Installers and binaries
# ------------------------------------------------------------
*.lnk
*.msi
*.exe

# ------------------------------------------------------------
# Test outputs
# ------------------------------------------------------------
test_output/
test_outputs/
test_results/
coverage.xml
junit.xml

# ------------------------------------------------------------
# Git leftovers
# ------------------------------------------------------------
*.patch
*.diff

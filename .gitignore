# ============================================================
# MTG Investment Terminal - Production .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/
.tox/
.nox/
.cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDEs
.vscode/
.idea/
*.code-workspace

# Secrets
.env
.env.*
!.env.example
config_local.py
config.local.py
local_config.py
credentials.json
secrets.json
tokens.json
auth.json
*.pem
*.key
*.p12
*.pfx
*.token

# Databases
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm

# Archives
*.7z
*.zip
*.rar
*.tar
*.tar.gz
*.tgz
*.xz
*.bz2


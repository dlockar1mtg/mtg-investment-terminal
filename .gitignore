# ------------------------------------------------------------

# Raw source downloads
data/raw/
data/input/
data/discovered/
data/source_cache/
data/market_database/
data/market_inputs/
data/market_signals/
data/rolling_metrics/
data/market_intelligence/
data/investment/
data/monte_carlo/
data/analytics/
data/dashboard/
data/warehouse/


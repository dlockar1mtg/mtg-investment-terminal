{
  "contract_name": "Collector Model Input Raw Lineage Contract",
  "contract_version": "1.0.0",
  "target_path": "data/discovered/collector_booster_model_input.csv",
  "required_evidence": [
    "target_sha256",
    "byte_identical_copies",
    "schema_equivalent_sources",
    "code_references",
    "writer_references",
    "candidate_upstream_inputs",
    "raw_observation_authority",
    "transformation_reproducibility"
  ],
  "prohibited_assumptions": [
    "model_input_is_raw_because_it_contains_dates",
    "derived_columns_are_historical_observations",
    "current_values_can_backfill_historical_dates",
    "unresolved_lineage_can_become_price_authority"
  ],
  "authority_states": [
    "RAW_LINEAGE_CERTIFIED",
    "DERIVED_LINEAGE_CERTIFIED",
    "LINEAGE_PARTIALLY_RECONSTRUCTED",
    "LINEAGE_UNRESOLVED"
  ],
  "authorization_policy": {
    "historical_price_authority_requires_raw_lineage_certified": true,
    "coverage_assessment_requires_historical_price_authority": true,
    "lifecycle_panel_build_requires_coverage_assessment": true,
    "model_tournament_requires_lifecycle_panel": true,
    "purchase_recommendations_require_model_tournament": true
  }
}

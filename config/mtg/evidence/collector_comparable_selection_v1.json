{
  "policy_name": "collector_comparable_selection",
  "policy_version": "1.0.0",
  "lane": "COLLECTOR_BOOSTER",
  "minimum_comparables": 3,
  "maximum_comparables": 7,
  "minimum_similarity_score": 55.0,
  "minimum_peer_history_statuses": [
    "CERTIFIED",
    "CERTIFIED_LIMITED"
  ],
  "weights": {
    "product_configuration": 0.15,
    "release_era": 0.15,
    "lifecycle_stage": 0.10,
    "price_band": 0.15,
    "supply_profile": 0.15,
    "liquidity_class": 0.15,
    "demand_profile": 0.15
  },
  "rules": {
    "target_must_be_comparable_evidence_ready": true,
    "peer_must_be_comparable_evidence_ready": true,
    "target_cannot_compare_to_itself": true,
    "peer_direct_history_must_be_certified": true,
    "missing_dimension_scores_zero": true,
    "no_projection_generated_by_selection_engine": true,
    "purchase_recommendation_authorized": false
  }
}